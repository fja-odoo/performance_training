<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Exercise 4: the "who owes us money" list view -->
    <record id="view_partner_overdue_list" model="ir.ui.view">
        <field name="name">res.partner.list.overdue</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Overdue Customers" create="false">
                <field name="display_name"/>
                <field name="email"/>
                <field name="country_id"/>
                <field name="overdue_invoice_count"/>
                <field name="overdue_amount"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_partner_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_partner_overdue_list"/>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_perf_advanced_overdue" name="Overdue Customers"
              parent="menu_perf_advanced_root"
              action="action_partner_overdue" sequence="20"/>

</odoo>
